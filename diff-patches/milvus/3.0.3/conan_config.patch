diff --git a/extensions/hooks/hook_loongarch.py b/extensions/hooks/hook_loongarch.py
new file mode 100644
index 0000000..e472c1e
--- /dev/null
+++ b/extensions/hooks/hook_loongarch.py
@@ -0,0 +1,18 @@
+import os
+import shutil
+
+def pre_build(conanfile, **kwargs):
+    source_folder = getattr(conanfile, "source_folder", None)
+    if not source_folder or not os.path.isdir(source_folder):
+        return
+    conanfile.output.info(
+        f"LoongArch Fix: patching config.guess/config.sub for {conanfile.name}"
+    )
+    for root, _, files in os.walk(source_folder):
+        for f in ("config.guess", "config.sub"):
+            if f not in files:
+                continue
+            patch_src = os.path.join("/src/patches", f)
+            target = os.path.join(root, f)
+            if os.path.isfile(patch_src):
+                shutil.copy2(patch_src, target)
