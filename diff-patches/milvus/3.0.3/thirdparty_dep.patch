+                '      set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=loongarch64")\n'
+                '    endif()\n'
+                '    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^s390x")'
+            )
+
